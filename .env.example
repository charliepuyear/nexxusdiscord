# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Sheets Spreadsheet ID (from the URL of your Google Sheet)
# Example: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Path to your Google Service Account credentials JSON file
GOOGLE_CREDENTIALS_FILE=credentials.json

# Discord Channel ID where signups are allowed (right-click channel > Copy ID)
SIGNUP_CHANNEL_ID=your_channel_id_here

# Admin Role name (users with this role can create/manage events)
ADMIN_ROLE=Race Director
